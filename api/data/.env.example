# 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 安全密钥（生产环境必须修改为随机字符串）
SECRET_KEY=your-secret-key-here

# 调试模式（生产环境设置为 false）
DEBUG=true

# JWT 加密算法
ALGORITHM=HS256

# 数据库连接
DATABASE_URI=sqlite://data/data.db

# Token 过期时间（分钟，默认1440即1天）
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 允许的来源（JSON 数组格式）
# CORS_ORIGINS=["http://localhost:3000","http://localhost:9527"]
